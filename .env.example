APP_NAME="jG Dashboard"
APP_ENV=local
# REQUERIDO (CWE-798): Generar clave única con 'php artisan key:generate --show'
APP_KEY=
# Modo debug: true solo para desarrollo local. En producción SIEMPRE false (CWE-215).
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=jg_dashboard
DB_USERNAME=postgres
# REQUERIDO: Contraseña segura para PostgreSQL
DB_PASSWORD=cambiar_por_contrasena_segura_de_bd

SESSION_DRIVER=file
SESSION_LIFETIME=120

JG_AGENTE_API_URL=http://127.0.0.1:8000
# REQUERIDO (CWE-798): Secreto compartido para firma criptográfica HMAC-SHA256 con jg_agente
JG_AGENTE_SECRET=cambiar_por_secreto_hmac_compartido_control_plane
# REQUERIDO (CWE-521): Contraseña explícita y robusta para el usuario admin del Dashboard (mínimo 16 caracteres)
ADMIN_DEFAULT_PASSWORD=cambiar_por_un_password_seguro_minimo_16_caracteres
